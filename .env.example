# این فایل را کپی کنید به .env و مقادیر واقعی را وارد کنید.
# هرگز فایل .env را کامیت یا داخل اپلیکیشن اندروید قرار ندهید.

# کلید API هوش مصنوعی - فقط اینجا روی سرور نگهداری می‌شود
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# مدل هوش مصنوعی قابل تعویض (OpenAI یا سازگار با آن)
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# دیتابیس بک‌اند (برای همگام‌سازی چند دستگاهی در آینده - نسخه فعلی SQLite لوکال کافی است)
DATABASE_URL=sqlite:///./tanakhah.db

# امنیت
SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - آدرس‌های مجاز برای دسترسی به Backend
ALLOWED_ORIGINS=*
